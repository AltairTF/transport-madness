    { "id": "goods", "name": "Goods", "payPerUnitKm": 30.0, "freeSeconds": 600.0, "zeroSeconds": 3000.0, "minPayShare": 0.3, "supplyPerDay": 280.0, "maxWaiting": 80.0 },
    { "id": "wood", "name": "Wood", "payPerUnitKm": 16.0, "freeSeconds": 900.0, "zeroSeconds": 4000.0, "minPayShare": 0.4, "supplyPerDay": 0.0, "maxWaiting": 200.0 },
