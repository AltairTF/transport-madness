// Simulation tuning and prices. This file is embedded in the simulation assembly (the sim project references it from
// here) and is the only place these numbers live: every key is required, unknown keys are rejected. Distances in
// metres, times in seconds, speeds in m/s, money in whole currency units.
{
  // Intelligent Driver Model, shared by every driver. Driver traits only change when to overtake.
  "driving": {
    "maxAccel": 1.5,
    "comfortDecel": 2.0,
    "minGap": 2.0,
    "timeHeadway": 1.5,
    "maxBraking": 9.0,          // physical limit; stops lane-change speed mismatches giving absurd decelerations
    "brakeJerk": 15.0,          // braking builds up at most this fast (m/s^3): drivers need a moment to react
    "minInteractionGap": 0.01,  // gaps are clamped to this before the IDM division
    "junctionRange": 40.0,      // within this distance of a junction a vehicle yields to conflicting traffic
    "conflictDistance": 5.0,    // two vehicles on crossing paths can touch while their centres are this close: that stretch of each path is where one waits for the other
    "crossingSafetyTime": 1.0,  // a vehicle that would arrive second still goes first when it is through the shared stretch this many seconds before the other gets to it
    "exitQueueSpeed": 3.0,      // a vehicle crawling slower than this at the start of an exit lane is a queue: the junction is not entered while it leaves no room
    "turnLateralAcceleration": 4.0, // m/s^2 a driver accepts when turning: sets the speed through a junction from the radius of the turn
    "minTurnSpeed": 3.0,        // never slower than this because of a turn
    "wideConflictDistance": 8.0, // conflictDistance and the path clearance (3.3 m) for a pair in which one vehicle is longer than a car: a bus reaches 5 m ahead of its path
    "wideBodyClearance": 6.1
  },

  // Ambient traffic placed by SeedTraffic.
  "traffic": {
    "spawnClearance": 12.0,       // free space needed around a spawn point, and kept from lane ends
    "spawnAttemptsPerVehicle": 30,
    "spawnSpeedFactor": 0.5,      // initial speed as a share of the lane's limit
    "driverSpeedFactorMin": 0.65, // personal share of the speed limit is drawn from min .. min + range
    "driverSpeedFactorRange": 0.35
  },

  "manoeuvres": {
    "decisionInterval": 10,     // ticks: each vehicle reconsiders this often, staggered by id
    "lateralRate": 0.8,         // lateral fraction per second: a lane change takes 1 / rate seconds
    "stallSpeed": 0.3,          // an overtaker slower than this counts as standing still
    "stallLimit": 4.0           // seconds standing still beside the target before giving up and cutting back in
  },

  // Free lane choice on multi-lane carriageways.
  "laneChange": {
    "cooldown": 60,                 // ticks between lane changes
    "endMargin": 30.0,              // no lane change this close to either end of a lane
    "hinderedGap": 35.0,            // a leader closer than this may be holding us up ...
    "hinderedSpeedShare": 0.85,     // ... when slower than this share of our free speed ...
    "hinderedSpeedDeficit": 1.5,    // ... by at least this much
    "leftGapAdvantage": 10.0,       // moving left needs this much more gap ahead ...
    "leftSpeedAdvantage": 2.0,      // ... or a leader this much faster
    "rightFreeGap": 50.0,           // moving back right needs this much gap ahead ...
    "rightSpeedShare": 0.85,        // ... or a leader at least this share of our free speed
    "frontGapBase": 8.0,            // gap needed ahead in the target lane: base + perSpeed * v
    "frontGapPerSpeed": 0.4,
    "closingGap": 25.0,             // a slower leader closer than this blocks the move ...
    "closingSpeedDelta": 2.0,       // ... when slower than us by more than this
    "rearGapBase": 6.0,             // gap needed behind: base + perSpeedDifference * (their speed - ours)
    "rearGapPerSpeedDifference": 2.0
  },

  // Overtaking via the oncoming lane on two-lane roads.
  "overtake": {
    "cooldown": 100,                // ticks after finishing a pass
    "minStart": 15.0,               // pulling out needs the vehicle itself this far clear of the junction it just left
    "endAbortMargin": 30.0,         // an overtaker this close to the end of the lane gives up
    "endRoom": 20.0,                // extra room left past the pass before the end of the lane
    "standingObstacle": 15.0,       // oncoming vehicle this close: no room to carry on whatever its speed
    "maxLeaderGap": 30.0,           // only consider a leader this close ...
    "minLeaderSpeed": 1.0,          // ... that is moving at least this fast ...
    "slowLeaderShare": 0.85,        // ... and slower than this share of our free speed ...
    "minSpeedDeficit": 1.5,         // ... by at least this much
    "queueSpeed": 2.0,              // a vehicle crawling below this is part of a queue
    "queueLookahead": 100.0,        // never start a pass with a queue this close ahead of the target
    "haltedLookahead": 80.0,        // nor with a halted vehicle this close ahead of the target
    "stuckBase": 1.5,               // seconds held up before trying: base + patience * stuckPatience
    "stuckPatience": 6.0,
    "boost": 1.1,                   // free speed while passing: boost + aggression * boostAggression
    "boostAggression": 0.1,
    "passLengthPad": 16.0,          // distance to cover for a pass: gap + 2 vehicle lengths + this
    "minRelativeSpeed": 2.0,        // floor on closing speed when timing a pass
    "sightBase": 60.0,              // how far ahead oncoming traffic is seen: base + attention * sightAttention
    "sightAttention": 240.0,
    "misperception": 0.6,           // inattentive drivers underestimate oncoming speed by up to this share
    "believedTimeBase": 0.6,        // ... and the duration of the pass: time * (base + attention * believedTimeAttention)
    "believedTimeAttention": 0.4,
    "safetyMargin": 30.0,           // extra distance wanted before oncoming traffic, shrunk by aggression
    "safetyAggression": 0.5,
    "abortTimeBase": 1.5,           // abort when oncoming time-to-collision falls below base + attention * abortTimeAttention
    "abortTimeAttention": 2.0,
    "returnBehindBase": 5.0,        // room needed behind to pull back in: base + perSpeedDifference * (their speed - ours)
    "returnBehindPerSpeed": 2.0,
    "returnAheadBase": 6.0,         // room needed ahead to pull back in: base + perSpeedDifference * (our speed - theirs)
    "returnAheadPerSpeed": 1.5
  },

  // Rescue crews. The crews a depot keeps depend on its level.
  "crews": {
    "dispatchDelay": 10.0,
    "speed": 16.0,                  // by road
    "roadDetour": 1.4,              // road distance over straight-line distance
    "fallbackResponse": 300.0,      // no depot can respond sooner: help comes from far away
    "clearDuration": 45.0,
    "perDepot": { "simple": 1, "workshop": 1, "complex": 2 }
  },

  "roads": {
    "twoLane": { "speedLimit": 14.0, "costPerMetre": 40.0 },
    "avenue": { "speedLimit": 19.0, "costPerMetre": 90.0 },
    "cutCostPerCubicMetre": 6.0,
    "fillCostPerCubicMetre": 9.0,
    "earthworkSlope": 1.5,          // horizontal metres per metre of height at the edge of a cut or fill
    "demolitionCostPerMetre": 10.0,
    "upgradeRefundShare": 0.5,      // of the two-lane price, for the part reused when widening to an avenue
    "downgradeCostPerMetre": 15.0,  // narrowing an avenue to a two-lane road
    "speedLimitChangeCostPerMetre": 1.0, // re-signing a road
    // Bridges and tunnels: a road that would need a fill deeper than maxFillDepth, a cut deeper than maxCutDepth, or
    // that crosses water, is built as a structure instead (no earthworks).
    "maxFillDepth": 6.0,            // metres of embankment before a bridge takes over
    "maxCutDepth": 8.0,             // metres of cutting before a tunnel takes over
    "structureMargin": 8.0,         // a structure starts this far before the ground that calls for it, and ends this far after
    "crossingClearance": 5.5,       // a road passes over or under another (no junction) when their surfaces are this far apart, with a bridge above or a tunnel below
    "bridgeCostPerMetre": 320.0,    // two-lane; replaces the road and earthwork price
    "tunnelCostPerMetre": 520.0,
    "avenueStructureFactor": 1.6    // an avenue on a bridge or in a tunnel costs this much more
  },

  // The company's money. One day is dayLength seconds of simulated time: upkeep and interest are charged daily. A day is long
  // enough for a commute to fit inside it; the per-day amounts are ten times what they were for a 60 s day, so the economy is unchanged per second.
  "economy": {
    "startingMoney": 1000000,
    "maxLoan": 1000000,
    "dayLength": 600.0,
    "daysPerMonth": 30,             // the calendar: shown on the HUD, and the pace of town growth
    "monthsPerYear": 12,
    "interestPerDay": 0.004,        // share of the loan, charged every day
    "debtLimit": 100000,            // net worth (money minus loan) below minus this counts as insolvent
    "bankruptcyDays": 73,           // consecutive insolvent days before the company goes bankrupt (the game goes on in sandbox)
    "sellRefundShare": 0.6,         // of the price, paid when a vehicle is sold
    "depotPrice": { "simple": 15000, "workshop": 40000, "complex": 90000 }
  },

  // Stations stand at a road node. On a map without towns every station simply produces each cargo at its fixed rate (supplyPerDay below); with towns passengers come from trip groups that queue there and cargo from the industries it covers.
  "stations": {
    "price": 8000,
    "upkeepPerDay": 150.0,
    "coverageRadius": 150.0,        // buildings within this distance of the station are served (the walking radius of the trips)
    "minApproach": 30.0,            // a stop lane shorter than this is not used, and a road is not split closer than this to its end
    "stopMargin": 3.0,              // a vehicle halts this far before the junction edge
    "arrivalGap": 3.5,              // the vehicle counts as arrived when its gap to the stop is this small ...
    "arrivalSpeed": 0.5,            // ... and it is slower than this
    "bayPrice": 6000,               // extra for a station with bays: loading vehicles pull out of the lane, so a bus loading does not hold up the road
    "bayUpkeepPerDay": 100.0,       // extra upkeep of the bays
    "bayCapacity": 2,               // vehicles that can load in the bays of a station at once; the next one stops in the lane as at a station without bays
    "bayExitGap": 30.0              // a vehicle leaves its bay only when no vehicle is within this distance behind it (and none overlaps it)
  },

  // Pay is quantity times distance (straight line between the stations) times the rate, reduced when the trip took long.
  // supplyPerDay is only for maps with neither towns nor industries: there every station produces that much of the cargo.
  "cargo": [
    { "id": "passengers", "name": "Passengers", "payPerUnitKm": 65.0, "freeSeconds": 240.0, "zeroSeconds": 1200.0, "minPayShare": 0.3, "supplyPerDay": 240.0, "maxWaiting": 120.0 },
    { "id": "goods", "name": "Goods", "payPerUnitKm": 30.0, "freeSeconds": 600.0, "zeroSeconds": 3000.0, "minPayShare": 0.3, "supplyPerDay": 140.0, "maxWaiting": 80.0 },
    { "id": "wood", "name": "Wood", "payPerUnitKm": 16.0, "freeSeconds": 900.0, "zeroSeconds": 4000.0, "minPayShare": 0.4, "supplyPerDay": 0.0, "maxWaiting": 200.0 },
    { "id": "planks", "name": "Planks", "payPerUnitKm": 22.0, "freeSeconds": 900.0, "zeroSeconds": 4000.0, "minPayShare": 0.4, "supplyPerDay": 0.0, "maxWaiting": 200.0 },
    { "id": "stone", "name": "Stone", "payPerUnitKm": 14.0, "freeSeconds": 1200.0, "zeroSeconds": 5000.0, "minPayShare": 0.5, "supplyPerDay": 0.0, "maxWaiting": 200.0 },
    { "id": "materials", "name": "Building materials", "payPerUnitKm": 25.0, "freeSeconds": 900.0, "zeroSeconds": 4000.0, "minPayShare": 0.4, "supplyPerDay": 0.0, "maxWaiting": 200.0 },
    { "id": "grain", "name": "Grain", "payPerUnitKm": 15.0, "freeSeconds": 600.0, "zeroSeconds": 3000.0, "minPayShare": 0.3, "supplyPerDay": 0.0, "maxWaiting": 200.0 },
    { "id": "food", "name": "Food", "payPerUnitKm": 28.0, "freeSeconds": 400.0, "zeroSeconds": 2000.0, "minPayShare": 0.2, "supplyPerDay": 0.0, "maxWaiting": 200.0 }
  ],


  // Towns: generated with the map, made of buildings on lots beside their streets (M3a). Satisfaction is 0 to 100 per town.
  "towns": {
    "names": [
      "Ashford", "Brindle", "Carrow", "Dunmere", "Elmsworth", "Fallowby", "Garrick", "Hollin", "Ivybridge", "Jarrow",
      "Kettering", "Lowmoor", "Marlow", "Norbury", "Oakhurst", "Pennick", "Quarley", "Redmarsh", "Stanwick", "Thornby",
      "Uplands", "Verley", "Wexcombe", "Yarrow"
    ],
    "initialSatisfaction": 60.0,
    "maxSatisfaction": 100.0,
    "recoveryPerMonth": 1.0,        // satisfaction regained every month, up to the maximum
    "demolishedPenalty": 0.5,       // lost for every building demolished to make room for a road
    "abandonedPenalty": 2.0,        // lost for every building that is marked abandoned
    "accessRadius": 40.0,           // a building has road access when a road's centre line is this close to its middle
    "inactiveMonths": 3,            // months without road access before a building is marked abandoned ...
    "abandonedMonths": 1,           // ... and months after that before the town demolishes it
    "unmetPenalty": 3.0,            // satisfaction lost each month if none of the buildings' needs were met; less in proportion to what was
    "initialStockMonths": 1.5,      // months of its monthly needs a building starts with in stock
    "sustainStockMonths": 2.0,      // months of its monthly needs a building keeps in stock at most

    // Growth (M3d), evaluated for every town at the turn of each month. A building whose construction stock is full for its
    // size goes up one size; one already at the top size spends a full stock on a new building on a free lot of its town (the
    // nearest to it), or on a new block of streets when no lot is free. Nothing grows while the town's satisfaction or its
    // connectivity is below its threshold. Connectivity is the share of the town's homes from which a group made a trip to
    // work or leisure that month within the time budget.
    "growth": {
      "minSatisfaction": 50.0,
      "minConnectivity": 0.6,
      "timeBudgetSeconds": 300.0,
      "lotClearance": 15.0,         // a free lot is built on only when no road runs closer than this to its middle
      "extendGrid": true            // a town with no free lot builds a new block of streets
    },

    // Where and how a town is laid out: a square grid of streets (the middle one an avenue) with two lots per block side.
    "generation": {
      "attempts": 600,              // random places tried for each town
      "edgeMargin": 300.0,          // a town stays this far from the edge of the map
      "minSpacing": 700.0,          // between town centres
      "maxHeightRange": 12.0,       // highest minus lowest ground under the town
      "waterMargin": 1.5,           // ground must stand this far above the water surface everywhere under the town
      "blocksMin": 3,               // blocks along each side of the grid
      "blocksMax": 5,
      "blockLength": 120.0,         // street to street; buildings stand on all four sides of a block, two to a side
      "lotWidth": 30.0,             // between the middles of the two buildings on one side of a block
      "setbackGap": 2.0             // clear space between the paved edge of an avenue and a building
    },

    // From the middle of a town out. 'until' is the distance from the centre as a share of half the grid; 'fill' the
    // share of lots that start built on; 'mix' the weights of home, commerce and industry; 'tiers' the weights of the sizes.
    "rings": [
      { "until": 0.35, "fill": 0.95, "mix": [0.35, 0.60, 0.05], "tiers": [0.2, 0.4, 0.4] },
      { "until": 0.70, "fill": 0.80, "mix": [0.65, 0.25, 0.10], "tiers": [0.4, 0.4, 0.2] },
      { "until": 1.00, "fill": 0.55, "mix": [0.70, 0.10, 0.20], "tiers": [0.7, 0.25, 0.05] }
    ],

    // One list per kind of building, three sizes each. size: half the side of the square it stands on, in metres.
    // people live in a home (and travel as trip groups, see 'trips'); jobs are in commerce and industry. sustain: what the
    // building uses up each month (a shortfall lowers the town's satisfaction); construction: how much it can hold of what
    // building (M3d) will spend.
    "buildingTypes": [
      { "id": "home", "tiers": [
        { "size": 8.0, "height": 6.0, "people": 8, "jobs": 0, "demolitionPrice": 3000,
          "sustain": [{ "cargo": "food", "amount": 20 }, { "cargo": "goods", "amount": 10 }],
          "construction": [{ "cargo": "materials", "amount": 40 }, { "cargo": "planks", "amount": 20 }] },
        { "size": 10.0, "height": 12.0, "people": 20, "jobs": 0, "demolitionPrice": 7000,
          "sustain": [{ "cargo": "food", "amount": 50 }, { "cargo": "goods", "amount": 25 }],
          "construction": [{ "cargo": "materials", "amount": 100 }, { "cargo": "planks", "amount": 50 }] },
        { "size": 12.0, "height": 24.0, "people": 50, "jobs": 0, "demolitionPrice": 16000,
          "sustain": [{ "cargo": "food", "amount": 120 }, { "cargo": "goods", "amount": 60 }],
          "construction": [{ "cargo": "materials", "amount": 240 }, { "cargo": "planks", "amount": 120 }] }
      ] },
      { "id": "commerce", "tiers": [
        { "size": 8.0, "height": 6.0, "people": 0, "jobs": 6, "demolitionPrice": 4000,
          "sustain": [{ "cargo": "goods", "amount": 30 }],
          "construction": [{ "cargo": "materials", "amount": 40 }, { "cargo": "planks", "amount": 20 }] },
        { "size": 10.0, "height": 10.0, "people": 0, "jobs": 16, "demolitionPrice": 9000,
          "sustain": [{ "cargo": "goods", "amount": 80 }],
          "construction": [{ "cargo": "materials", "amount": 100 }, { "cargo": "planks", "amount": 50 }] },
        { "size": 12.0, "height": 18.0, "people": 0, "jobs": 40, "demolitionPrice": 20000,
          "sustain": [{ "cargo": "goods", "amount": 180 }],
          "construction": [{ "cargo": "materials", "amount": 240 }, { "cargo": "planks", "amount": 120 }] }
      ] },
      { "id": "industry", "tiers": [
        { "size": 9.0, "height": 6.0, "people": 0, "jobs": 10, "demolitionPrice": 5000,
          "sustain": [{ "cargo": "planks", "amount": 30 }],
          "construction": [{ "cargo": "materials", "amount": 40 }, { "cargo": "planks", "amount": 20 }] },
        { "size": 11.0, "height": 8.0, "people": 0, "jobs": 25, "demolitionPrice": 11000,
          "sustain": [{ "cargo": "planks", "amount": 70 }],
          "construction": [{ "cargo": "materials", "amount": 100 }, { "cargo": "planks", "amount": 50 }] },
        { "size": 12.0, "height": 10.0, "people": 0, "jobs": 60, "demolitionPrice": 25000,
          "sustain": [{ "cargo": "planks", "amount": 150 }],
          "construction": [{ "cargo": "materials", "amount": 240 }, { "cargo": "planks", "amount": 120 }] }
      ] }
    ]
  },

  // Trip groups (M3c): the people of a home travel in groups of at most groupSize between home, a workplace and a leisure
  // place, on a daily schedule. Windows are hours of the day; a group's own time inside a window and its jitter are drawn once
  // from the seed. A group walks when the place is within walkRadius, otherwise takes the mode (car, public transport) with the
  // lowest generalised cost: seconds plus moneyWeight times the money it costs.
  "trips": {
    "groupSize": 10,                // people in one trip group at most; a bigger home has several
    "carShare": 0.6,                // share of the groups that have a car
    "peoplePerCar": 2,              // people one ambient car stands for
    "walkRadius": 150.0,            // straight-line distance within which people walk
    "walkSpeed": 2.5,               // a day is 600 s, so a pace in m/s is about five times quicker than life against a car at 14 m/s
    "walkDetour": 1.3,              // path over straight-line distance when walking
    "workRadius": 1800.0,           // workplaces and leisure places are looked for this far from home
    "nearness": 300.0,              // a place this far away counts half as much as one next door (weights fall as 1 / (1 + (d / nearness)^2))
    "leisureChance": 0.6,           // chance per day that a group goes out in the evening
    "jitterMinutes": 45,            // each group's fixed extra delay after the start of a window, up to this
    "leisureStayMinutes": 60,       // least time spent at the leisure place before going home
    "windows": {
      "workOut":     { "from": 7.0,  "to": 9.0 },
      "workBack":    { "from": 16.0, "to": 18.0 },
      "leisureOut":  { "from": 18.0, "to": 21.0 },
      "leisureBack": { "from": 21.0, "to": 22.5 }
    },
    "moneyWeight": 1.5,             // seconds one currency unit counts for in the generalised cost
    "carCostPerKm": 30.0,
    "carOverheadSeconds": 60.0,     // finding the car and parking it
    "carAccessRadius": 150.0,       // a building is reached by car from a road node this close
    "transitWaitSeconds": 240.0,    // average wait for a line with one vehicle; shared out over the line's vehicles
    "transitRideFactor": 1.3,       // a bus takes this much longer than a car over the same road (stops, turns)
    "transitGiveUpSeconds": 900.0,  // people who have waited this long at a station give up
    "maxCars": 300,                 // trip cars on the road at once; the rest of the trips wait for room
    "carDepartGapSeconds": 2.0,     // between two cars of the same group
    "carSpawnClearance": 3.0,       // free road needed around a new car, beyond its own length
    "carSpawnAttempts": 8,          // places tried per step to put a waiting car on the road
    "carArriveRange": 30.0,         // a car is at its destination when this close to the end of the lane into the node (it is parked out of the way of the queue)
    "carTimeoutSeconds": 400.0,     // a car still on the road after this long is taken off and its people count as arrived (a jam clears itself, slowly)
    "carStuckSeconds": 90.0,        // a car that has hardly moved for this long is taken off too: people give up on a jam and walk (a day is 600 s)
    "congestionSmoothing": 0.15,    // people learn how slow the roads are at each hour: every car trip that ends moves that hour's estimate this share of the way to what it took
    "maxCongestion": 6.0            // the estimate (trip time over the time on empty roads) never goes above this
  },

  // Industries: the producers and processors of the cargo chains (M3b), placed by the generator on level dry land away from
  // towns. A primary industry has no inputs and produces perMonth into its output stock; a processor makes at most perMonth
  // of its output, each unit using up the listed amounts of its inputs, and stops when an input runs out or the output is
  // full. Stations covering an industry share its output; deliveries to a station fill the inputs of the industries it covers.
  "industries": {
    "generation": {
      "attempts": 500,
      "edgeMargin": 250.0,
      "townClearance": 150.0,       // from the edge of a town's grid
      "minSpacing": 350.0,          // between industries
      "maxHeightRange": 5.0         // highest minus lowest ground under it
    },
    // How many of each type, in the order of 'types', for the three settings of the new-game screen.
    "counts": {
      "few":    [1, 1, 1, 1, 1, 1, 1],
      "normal": [2, 1, 2, 1, 1, 1, 1],
      "many":   [3, 2, 3, 2, 2, 2, 2]
    },
    "types": [
      { "id": "forest", "name": "Forest", "size": 30.0, "height": 8.0, "output": "wood", "perMonth": 4500.0, "maxOutput": 600.0, "inputs": [], "maxInput": 0.0, "color": [0.20, 0.45, 0.22] },
      { "id": "quarry", "name": "Quarry", "size": 28.0, "height": 6.0, "output": "stone", "perMonth": 3600.0, "maxOutput": 600.0, "inputs": [], "maxInput": 0.0, "color": [0.55, 0.52, 0.48] },
      { "id": "farm", "name": "Farm", "size": 30.0, "height": 5.0, "output": "grain", "perMonth": 4500.0, "maxOutput": 600.0, "inputs": [], "maxInput": 0.0, "color": [0.82, 0.72, 0.30] },
      { "id": "sawmill", "name": "Sawmill", "size": 22.0, "height": 12.0, "output": "planks", "perMonth": 4500.0, "maxOutput": 600.0, "inputs": [{ "cargo": "wood", "amount": 1.0 }], "maxInput": 600.0, "color": [0.62, 0.42, 0.24] },
      { "id": "cementworks", "name": "Cement works", "size": 22.0, "height": 16.0, "output": "materials", "perMonth": 3600.0, "maxOutput": 600.0, "inputs": [{ "cargo": "stone", "amount": 1.0 }], "maxInput": 600.0, "color": [0.70, 0.70, 0.74] },
      { "id": "foodplant", "name": "Food plant", "size": 22.0, "height": 12.0, "output": "food", "perMonth": 4500.0, "maxOutput": 600.0, "inputs": [{ "cargo": "grain", "amount": 1.0 }], "maxInput": 600.0, "color": [0.85, 0.45, 0.35] },
      { "id": "factory", "name": "Factory", "size": 22.0, "height": 14.0, "output": "goods", "perMonth": 3600.0, "maxOutput": 600.0, "inputs": [{ "cargo": "planks", "amount": 1.0 }], "maxInput": 600.0, "color": [0.40, 0.45, 0.62] }
    ]
  },

  // The vehicles the company can buy at a depot. A model that carries 'freight' takes whichever freight cargo (anything but
  // passengers) is waiting at a stop and wanted at the next one.
