    { "id": "grain", "name": "Grain", "payPerUnitKm": 15.0, "freeSeconds": 600.0, "zeroSeconds": 3000.0, "minPayShare": 0.3, "supplyPerDay": 0.0, "maxWaiting": 200.0 },
    { "id": "food", "name": "Food", "payPerUnitKm": 28.0, "freeSeconds": 400.0, "zeroSeconds": 2000.0, "minPayShare": 0.2, "supplyPerDay": 0.0, "maxWaiting": 200.0 },
    { "id": "coal", "name": "Coal", "payPerUnitKm": 15.0, "freeSeconds": 1200.0, "zeroSeconds": 5000.0, "minPayShare": 0.5, "supplyPerDay": 0.0, "maxWaiting": 200.0 },
    { "id": "ore", "name": "Iron ore", "payPerUnitKm": 14.0, "freeSeconds": 1200.0, "zeroSeconds": 5000.0, "minPayShare": 0.5, "supplyPerDay": 0.0, "maxWaiting": 200.0 },
    { "id": "steel", "name": "Steel", "payPerUnitKm": 30.0, "freeSeconds": 900.0, "zeroSeconds": 4000.0, "minPayShare": 0.4, "supplyPerDay": 0.0, "maxWaiting": 200.0 },
    { "id": "fuel", "name": "Fuel", "payPerUnitKm": 26.0, "freeSeconds": 600.0, "zeroSeconds": 3000.0, "minPayShare": 0.3, "supplyPerDay": 0.0, "maxWaiting": 200.0 },
    { "id": "oil", "name": "Oil", "payPerUnitKm": 20.0, "freeSeconds": 900.0, "zeroSeconds": 4000.0, "minPayShare": 0.4, "supplyPerDay": 0.0, "maxWaiting": 200.0 },
    { "id": "rubber", "name": "Rubber", "payPerUnitKm": 24.0, "freeSeconds": 900.0, "zeroSeconds": 4000.0, "minPayShare": 0.4, "supplyPerDay": 0.0, "maxWaiting": 200.0 },
    { "id": "engines", "name": "Engines", "payPerUnitKm": 45.0, "freeSeconds": 900.0, "zeroSeconds": 4000.0, "minPayShare": 0.4, "supplyPerDay": 0.0, "maxWaiting": 100.0 },
    { "id": "bodies", "name": "Truck bodies", "payPerUnitKm": 38.0, "freeSeconds": 900.0, "zeroSeconds": 4000.0, "minPayShare": 0.4, "supplyPerDay": 0.0, "maxWaiting": 100.0 },
