// Simulation tuning and prices. This file is embedded in the simulation assembly (the sim project references it from
// here) and is the only place these numbers live: every key is required, unknown keys are rejected. Distances in
// metres, times in seconds, speeds in m/s, money in whole currency units.
{
  // Intelligent Driver Model, shared by every driver. Driver traits only change when to overtake.
  "driving": {
    "maxAccel": 1.5,
    "comfortDecel": 2.0,
    "minGap": 2.0,
    "timeHeadway": 1.5,
    "maxBraking": 9.0,          // physical limit; stops lane-change speed mismatches giving absurd decelerations
    "brakeJerk": 15.0,          // braking builds up at most this fast (m/s^3): drivers need a moment to react
    "minInteractionGap": 0.01,  // gaps are clamped to this before the IDM division
    "junctionRange": 40.0,      // within this distance of a junction a vehicle yields to conflicting traffic
    "conflictDistance": 5.0,    // two vehicles on crossing paths can touch while their centres are this close: that stretch of each path is where one waits for the other
    "crossingSafetyTime": 1.0,  // a vehicle that would arrive second still goes first when it is through the shared stretch this many seconds before the other gets to it
    "exitQueueSpeed": 3.0,      // a vehicle crawling slower than this at the start of an exit lane is a queue: the junction is not entered while it leaves no room
    "turnLateralAcceleration": 4.0, // m/s^2 a driver accepts when turning: sets the speed through a junction from the radius of the turn
    "minTurnSpeed": 3.0,        // never slower than this because of a turn
    "wideConflictDistance": 8.0, // conflictDistance and the path clearance (3.3 m) for a pair in which one vehicle is longer than a car: a bus reaches 5 m ahead of its path
    "wideBodyClearance": 6.1
  },

  // Ambient traffic placed by SeedTraffic.
  "traffic": {
    "spawnClearance": 12.0,       // free space needed around a spawn point, and kept from lane ends
    "spawnAttemptsPerVehicle": 30,
    "spawnSpeedFactor": 0.5,      // initial speed as a share of the lane's limit
    "driverSpeedFactorMin": 0.65, // personal share of the speed limit is drawn from min .. min + range
    "driverSpeedFactorRange": 0.35,
    "ambientPerTown": 4           // through-traffic put on a new map per town so the roads between towns are not dead (the streets are driven by trip groups)
  },

  "manoeuvres": {
    "decisionInterval": 10,     // ticks: each vehicle reconsiders this often, staggered by id
    "lateralRate": 0.8,         // lateral fraction per second: a lane change takes 1 / rate seconds
    "stallSpeed": 0.3,          // an overtaker slower than this counts as standing still
    "stallLimit": 4.0           // seconds standing still beside the target before giving up and cutting back in
  },

  // Free lane choice on multi-lane carriageways.
  "laneChange": {
    "cooldown": 60,                 // ticks between lane changes
    "endMargin": 30.0,              // no lane change this close to either end of a lane
    "hinderedGap": 35.0,            // a leader closer than this may be holding us up ...
    "hinderedSpeedShare": 0.85,     // ... when slower than this share of our free speed ...
    "hinderedSpeedDeficit": 1.5,    // ... by at least this much
    "leftGapAdvantage": 10.0,       // moving left needs this much more gap ahead ...
    "leftSpeedAdvantage": 2.0,      // ... or a leader this much faster
    "rightFreeGap": 50.0,           // moving back right needs this much gap ahead ...
    "rightSpeedShare": 0.85,        // ... or a leader at least this share of our free speed
    "frontGapBase": 8.0,            // gap needed ahead in the target lane: base + perSpeed * v
    "frontGapPerSpeed": 0.4,
    "closingGap": 25.0,             // a slower leader closer than this blocks the move ...
    "closingSpeedDelta": 2.0,       // ... when slower than us by more than this
    "rearGapBase": 6.0,             // gap needed behind: base + perSpeedDifference * (their speed - ours)
    "rearGapPerSpeedDifference": 2.0
  },

  // Overtaking via the oncoming lane on two-lane roads.
  "overtake": {
    "cooldown": 100,                // ticks after finishing a pass
    "minStart": 15.0,               // pulling out needs the vehicle itself this far clear of the junction it just left
    "endAbortMargin": 30.0,         // an overtaker this close to the end of the lane gives up
    "endRoom": 20.0,                // extra room left past the pass before the end of the lane
    "standingObstacle": 15.0,       // oncoming vehicle this close: no room to carry on whatever its speed
    "maxLeaderGap": 30.0,           // only consider a leader this close ...
    "minLeaderSpeed": 1.0,          // ... that is moving at least this fast ...
    "slowLeaderShare": 0.85,        // ... and slower than this share of our free speed ...
    "minSpeedDeficit": 1.5,         // ... by at least this much
    "queueSpeed": 2.0,              // a vehicle crawling below this is part of a queue
    "queueLookahead": 100.0,        // never start a pass with a queue this close ahead of the target
    "haltedLookahead": 80.0,        // nor with a halted vehicle this close ahead of the target
    "stuckBase": 1.5,               // seconds held up before trying: base + patience * stuckPatience
    "stuckPatience": 6.0,
    "boost": 1.1,                   // free speed while passing: boost + aggression * boostAggression
    "boostAggression": 0.1,
    "passLengthPad": 16.0,          // distance to cover for a pass: gap + 2 vehicle lengths + this
    "minRelativeSpeed": 2.0,        // floor on closing speed when timing a pass
    "sightBase": 60.0,              // how far ahead oncoming traffic is seen: base + attention * sightAttention
    "sightAttention": 240.0,
    "misperception": 0.6,           // inattentive drivers underestimate oncoming speed by up to this share
    "believedTimeBase": 0.6,        // ... and the duration of the pass: time * (base + attention * believedTimeAttention)
    "believedTimeAttention": 0.4,
    "safetyMargin": 30.0,           // extra distance wanted before oncoming traffic, shrunk by aggression
    "safetyAggression": 0.5,
    "abortTimeBase": 1.5,           // abort when oncoming time-to-collision falls below base + attention * abortTimeAttention
    "abortTimeAttention": 2.0,
    "returnBehindBase": 5.0,        // room needed behind to pull back in: base + perSpeedDifference * (their speed - ours)
    "returnBehindPerSpeed": 2.0,
    "returnAheadBase": 6.0,         // room needed ahead to pull back in: base + perSpeedDifference * (our speed - theirs)
    "returnAheadPerSpeed": 1.5
  },

  // Rescue crews. The crews a depot keeps depend on its level.
  "crews": {
    "dispatchDelay": 10.0,
    "speed": 16.0,                  // by road
    "roadDetour": 1.4,              // road distance over straight-line distance
    "fallbackResponse": 300.0,      // no depot can respond sooner: help comes from far away
    "clearDuration": 45.0,
    "depotSnapRadius": 60.0,        // a depot goes on the node nearest the point clicked within this distance
    "incidentsKept": 500,           // cleared incidents kept in memory for the record (the oldest are dropped once there are more); open ones are never dropped
    "perDepot": { "simple": 1, "workshop": 1, "complex": 2 }
  },

  "roads": {
    "twoLane": { "speedLimit": 14.0, "costPerMetre": 40.0 },
    "avenue": { "speedLimit": 19.0, "costPerMetre": 90.0 },
    "cutCostPerCubicMetre": 6.0,
    "fillCostPerCubicMetre": 9.0,
    "earthworkSlope": 1.5,          // horizontal metres per metre of height at the edge of a cut or fill
    "demolitionCostPerMetre": 10.0,
    "upgradeRefundShare": 0.5,      // of the two-lane price, for the part reused when widening to an avenue
    "downgradeCostPerMetre": 15.0,  // narrowing an avenue to a two-lane road
    "speedLimitChangeCostPerMetre": 1.0, // re-signing a road
    // Bridges and tunnels: a road that would need a fill deeper than maxFillDepth, a cut deeper than maxCutDepth, or
    // that crosses water, is built as a structure instead (no earthworks).
    "maxFillDepth": 6.0,            // metres of embankment before a bridge takes over
    "maxCutDepth": 8.0,             // metres of cutting before a tunnel takes over
    "structureMargin": 8.0,         // a structure starts this far before the ground that calls for it, and ends this far after
    "crossingClearance": 5.5,       // a road passes over or under another (no junction) when their surfaces are this far apart, with a bridge above or a tunnel below
    "bridgeCostPerMetre": 320.0,    // two-lane; replaces the road and earthwork price
    "tunnelCostPerMetre": 520.0,
    "avenueStructureFactor": 1.6,   // an avenue on a bridge or in a tunnel costs this much more
    // Traffic lights (M4): the approaches of a junction fall in two groups by the direction they come from; the groups take turns.
    "trafficLight": { "price": 12000, "upkeepPerDay": 240.0, "greenSeconds": 18.0, "clearSeconds": 4.0 },
    // Signs (M4): a priority road sign on an approach, and the opposite one, makes every approach without a sign give way to it; a yield sign
    // makes its own approach give way to every approach without one; a stop sign is a yield sign after a full stop of stopSeconds. Approaches
    // of the same kind take the junction by arrival, as at a junction without signs. approachRange is how far back a vehicle that gives way looks.
    "signs": { "priorityPrice": 700, "yieldPrice": 500, "stopPrice": 500, "pickRadius": 30.0, "approachRange": 90.0, "stopSeconds": 1.5, "stopSpeed": 0.4, "stopLine": 5.0 }
  },

  // The company's money. One day is dayLength seconds of simulated time: upkeep and interest are charged daily. A day (1200 s) is
  // the cycle of people's lives, long enough for a commute to be a small part of it; a month is only daysPerMonth days, the calendar of
  // the campaign (96 months from January 1938 are 288 days). The per-day amounts are twice what they were for a 600 s day and the
  // per-month amounts (production, needs, construction) a fifth of what they were for a 30-day month, so every flow is unchanged per second.
  "economy": {
    "startingMoney": 1000000,
    "maxLoan": 1000000,
    "dayLength": 1200.0,
    "daysPerMonth": 3,              // the calendar: shown on the HUD, and the pace of town growth
    "startYear": 1938,              // the first month of a game is January of this year
    "monthsPerYear": 12,
    "interestPerDay": 0.008,        // share of the loan, charged every day
    "debtLimit": 100000,            // net worth (money minus loan) below minus this counts as insolvent
    "bankruptcyDays": 36,           // consecutive insolvent days before the company goes bankrupt (the game goes on in sandbox)
    "sellRefundShare": 0.6,         // of the price, paid when a vehicle is sold
    "parkedUpkeepShare": 0.1,       // of its daily upkeep, paid by a vehicle or train waiting in a depot on no line
    "depotPrice": { "simple": 15000, "workshop": 40000, "complex": 90000 }
  },

  // Stations stand at a road node. On a map without towns every station simply produces each cargo at its fixed rate (supplyPerDay below); with towns passengers come from trip groups that queue there and cargo from the industries it covers.
  "stations": {
    "price": 8000,
    "upkeepPerDay": 300.0,
    "coverageRadius": 150.0,        // buildings within this distance of the station are served (the walking radius of the trips)
    "minApproach": 30.0,            // a stop lane shorter than this is not used, and a road is not split closer than this to its end
    "stopMargin": 3.0,              // a vehicle halts this far before the junction edge
    "arrivalGap": 3.5,              // the vehicle counts as arrived when its gap to the stop is this small ...
    "arrivalSpeed": 0.5,            // ... and it is slower than this
    "bayPrice": 6000,               // extra for a station with bays: loading vehicles pull out of the lane, so a bus loading does not hold up the road
    "bayUpkeepPerDay": 200.0,       // extra upkeep of the bays
    "bayCapacity": 2,               // vehicles that can load in the bays of a station at once; the next one stops in the lane as at a station without bays
    "bayExitGap": 30.0              // a vehicle leaves its bay only when no vehicle is within this distance behind it (and none overlaps it)
  },

  // Rail (M4). Trains are on a network of their own (tracks join road nodes only at level crossings). Tracks are single and run both
  // ways; signals and stations mark where the next stretch has to be asked for. All lengths in metres, speeds in m/s, masses in kilograms.
  "rail": {
    "trackCostPerMetre": 110.0,
    "cutCostPerCubicMetre": 8.0,
    "fillCostPerCubicMetre": 12.0,
    "earthworkSlope": 1.5,
    "demolitionCostPerMetre": 20.0,
    "bridgeCostPerMetre": 780.0,
    "tunnelCostPerMetre": 1250.0,
    "maxGrade": 0.04,               // steepest track that can be built
    "freeGrade": 0.012,             // up to this grade the speed limit is unaffected; at maxGrade it is halved
    "minRadius": 90.0,              // tightest curve
    "maxSweep": 2.8,
    "minTrackLength": 20.0,
    "speedLimit": 36.0,             // posted speed of every track (about 130 km/h)
    "curveLateralAcceleration": 0.9,
    "halfWidth": 3.0,               // cleared and graded this far each side of the centre line
    "shoulder": 5.0,
    "maxFillDepth": 5.0,
    "maxCutDepth": 6.0,
    "structureMargin": 12.0,
    "maxTurnAngle": 0.9,            // the sharpest change of direction a train can make at a junction (radians); anything sharper is no connection
    "turnoutSpeed": 14.0,           // through a junction that bends the way, at most this ...
    "minTurnoutSpeed": 6.0,         // ... down to this at the sharpest turn
    "signalPrice": 1500,
    "pathSignalPrice": 2500,
    "stationPrice": 20000,
    "stationUpkeepPerDay": 500.0,
    "depotPrice": 30000,             // a Simple rail depot; the Workshop and Complex levels cost these
    "depotWorkshopPrice": 70000,
    "depotComplexPrice": 150000,
    "snapRadius": 14.0,             // a click this close to a rail node or a track's centre line picks it
    "stationAlongStep": 5.0,
    "movement": {
      "serviceBrake": 0.6,
      "emergencyBrake": 1.2,
      "brakePlanShare": 0.8,        // the speed profile toward a stop uses this share of the service brake
      "controlGain": 1.2,
      "stopMargin": 1.0,            // a train stops this far short of a red signal or a closed end of reservation
      "reserveLookahead": 30.0,     // a train asks for the track beyond a signal this far before it (plus its braking distance)
      "rollingResistance": 0.0025,
      "airResistance": 6.0,
      "gravity": 9.81,
      "blockedSeconds": 90.0,
      "horizon": 1800.0,
      "depotSpawnClearance": 2.0
    },
    "crossings": {
      "bandHalfWidth": 3.5,
      "warnSeconds": 16.0,
      "lowerSeconds": 4.0,
      "clearSeconds": 3.0,
      "minFromNode": 24.0,
      "minAngle": 0.35,
      "roadStopMargin": 2.5,
      "collisionHalt": 40.0,
      "price": 6000,
      "clearance": 4.0
    },
    "locomotives": [
      { "id": "diesel", "name": "Diesel locomotive", "length": 18.0, "mass": 90000.0, "power": 1600000.0, "tractiveEffort": 220000.0, "maxSpeed": 36.0, "maxWagons": 8, "price": 120000, "upkeepPerDay": 2000.0 }
    ],
    "wagons": [
      { "id": "coach", "name": "Passenger coach", "cargo": "passengers", "capacity": 48, "length": 20.0, "mass": 26000.0, "unitMass": 80.0, "price": 36000, "upkeepPerDay": 400.0, "dwellSeconds": 10.0, "secondsPerUnit": 0.15 },
      { "id": "freight", "name": "Freight wagon", "cargo": "freight", "capacity": 40, "length": 16.0, "mass": 20000.0, "unitMass": 600.0, "price": 30000, "upkeepPerDay": 300.0, "dwellSeconds": 10.0, "secondsPerUnit": 0.2 }
    ]
  },

  // Condition (0 to 100) of the company's vehicles and trains: it falls with the distance driven, rises with repairs done in depots, and a low one brings breakdowns.
  "maintenance": {
    "metresPerPoint": 1500.0,       // metres driven for one point lost
    "loadedWear": 0.3,              // wear is this much faster at a full load
    "patchedWearFactor": 1.5,       // wear of a patched vehicle until its next Service or Overhaul
    "noRiskAbove": 60.0,            // no breakdown risk at or above this Condition
    "highRiskBelow": 20.0,          // the risk reaches hazardPerKmAtFloor here ...
    "hazardPerKmAtFloor": 0.005,    // ... breakdowns per km driven ...
    "hazardPerKmAtZero": 0.1,       // ... and this at Condition 0
    "brakeFadeBelow": 60.0,         // below this Condition the brakes lose strength ...
    "worstBrakeShare": 0.6,         // ... down to this share of the braking at Condition 0
    "wreckCondition": 5.0,          // Condition of a vehicle after a breakdown
    "criticalCondition": 15.0,      // a breakdown below this is negligence (fined)
    "trainBreakdownSeconds": 150.0, // a broken-down train stands this long before the crew has cleared it
    "oldVehicleRepairFactor": 1.0,  // no effect until the campaign has model years
    "patch": { "gain": 15.0, "ceiling": 100.0, "seconds": 20.0, "priceShare": 0.03 },
    "service": { "gain": 50.0, "ceiling": 100.0, "seconds": 60.0, "priceShare": 0.12 },
    "overhaul": { "gain": 100.0, "ceiling": 95.0, "seconds": 180.0, "priceShare": 0.4 },
    "bays": { "simple": 1, "workshop": 2, "complex": 3 },   // vehicles a depot repairs at once
    "defaultPolicy": { "everyDays": 60, "belowCondition": 40, "repair": "service" },
    "frequency": { "off": 0.0, "low": 0.5, "normal": 1.0, "high": 2.0 },   // scale of the random events
    "signals": {
      "wearPerPassage": 0.3,        // points lost each time a train is let through
      "passageMetres": 500.0,       // a passage counts as this many metres of driving in the breakdown risk
      "repairedCondition": 70.0,    // after a crew has repaired a failure
      "repairPrice": 600,
      "fineAfterSeconds": 600.0     // a failure that takes longer to repair is negligence (no depot near)
    },
    "roads": {
      "passesPerPoint": 4000.0,     // vehicles driving a section's whole length, for one point of Condition lost
      "noEffectAbove": 80.0,        // no effect on speed or risk at or above this Condition
      "worstSpeedShare": 0.7,       // of the speed limit at Condition 0 (it falls evenly below noEffectAbove)
      "worstRiskFactor": 3.0,       // times the breakdown risk of a company vehicle at Condition 0
      "resurfacePricePerMetre": 60.0,
      "resurfaceMetresPerSecond": 2.0   // a crew resurfaces this much road each second; the road is closed for that long
    },
    "consequences": {
      "injuredShare": 0.3,          // of the passengers aboard a company vehicle that crashes
      "compensationPerInjured": 900,
      "negligenceFine": 15000,
      "townIncidentPenalty": 2.0,   // satisfaction lost by the town an incident of a company vehicle happens in
      "townBlockedPenalty": 3.0,    // and again when such an incident has blocked a road for blockedSeconds
      "blockedSeconds": 3600.0,
      "townMargin": 60.0            // metres beyond the blocks of the town that still count as inside it
    }
  },

  // Pay is quantity times distance (straight line between the stations) times the rate, reduced when the trip took long.
  // supplyPerDay is only for maps with neither towns nor industries: there every station produces that much of the cargo.
  "cargo": [
