// Simulation tuning and prices. This file is embedded in the simulation assembly (the sim project references it from
// here) and is the only place these numbers live: every key is required, unknown keys are rejected. Distances in
// metres, times in seconds, speeds in m/s, money in whole currency units.
{
  // Intelligent Driver Model, shared by every driver. Driver traits only change when to overtake.
  "driving": {
    "maxAccel": 1.5,
    "comfortDecel": 2.0,
    "minGap": 2.0,
    "timeHeadway": 1.5,
    "maxBraking": 9.0,          // physical limit; stops lane-change speed mismatches giving absurd decelerations
    "brakeJerk": 15.0,          // braking builds up at most this fast (m/s^3): drivers need a moment to react
    "minInteractionGap": 0.01,  // gaps are clamped to this before the IDM division
    "junctionRange": 40.0,      // within this distance of a junction a vehicle yields to conflicting traffic
    "conflictDistance": 5.0,    // two vehicles on crossing paths can touch while their centres are this close: that stretch of each path is where one waits for the other
    "crossingSafetyTime": 1.0,  // a vehicle that would arrive second still goes first when it is through the shared stretch this many seconds before the other gets to it
    "exitQueueSpeed": 3.0,      // a vehicle crawling slower than this at the start of an exit lane is a queue: the junction is not entered while it leaves no room
    "turnLateralAcceleration": 4.0, // m/s^2 a driver accepts when turning: sets the speed through a junction from the radius of the turn
    "minTurnSpeed": 3.0,        // never slower than this because of a turn
    "wideConflictDistance": 8.0, // conflictDistance and the path clearance (3.3 m) for a pair in which one vehicle is longer than a car: a bus reaches 5 m ahead of its path
    "wideBodyClearance": 6.1
  },

  // Ambient traffic placed by SeedTraffic.
  "traffic": {
    "spawnClearance": 12.0,       // free space needed around a spawn point, and kept from lane ends
    "spawnAttemptsPerVehicle": 30,
    "spawnSpeedFactor": 0.5,      // initial speed as a share of the lane's limit
    "driverSpeedFactorMin": 0.65, // personal share of the speed limit is drawn from min .. min + range
    "driverSpeedFactorRange": 0.35,
    "ambientPerTown": 4           // through-traffic put on a new map per town so the roads between towns are not dead (the streets are driven by trip groups)
  },

  "manoeuvres": {
    "decisionInterval": 10,     // ticks: each vehicle reconsiders this often, staggered by id
    "lateralRate": 0.8,         // lateral fraction per second: a lane change takes 1 / rate seconds
    "stallSpeed": 0.3,          // an overtaker slower than this counts as standing still
    "stallLimit": 4.0           // seconds standing still beside the target before giving up and cutting back in
  },

  // Free lane choice on multi-lane carriageways.
  "laneChange": {
    "cooldown": 60,                 // ticks between lane changes
    "endMargin": 30.0,              // no lane change this close to either end of a lane
    "hinderedGap": 35.0,            // a leader closer than this may be holding us up ...
    "hinderedSpeedShare": 0.85,     // ... when slower than this share of our free speed ...
    "hinderedSpeedDeficit": 1.5,    // ... by at least this much
    "leftGapAdvantage": 10.0,       // moving left needs this much more gap ahead ...
    "leftSpeedAdvantage": 2.0,      // ... or a leader this much faster
    "rightFreeGap": 50.0,           // moving back right needs this much gap ahead ...
    "rightSpeedShare": 0.85,        // ... or a leader at least this share of our free speed
    "frontGapBase": 8.0,            // gap needed ahead in the target lane: base + perSpeed * v
    "frontGapPerSpeed": 0.4,
    "closingGap": 25.0,             // a slower leader closer than this blocks the move ...
    "closingSpeedDelta": 2.0,       // ... when slower than us by more than this
    "rearGapBase": 6.0,             // gap needed behind: base + perSpeedDifference * (their speed - ours)
    "rearGapPerSpeedDifference": 2.0
  },

  // Overtaking via the oncoming lane on two-lane roads.
  "overtake": {
    "cooldown": 100,                // ticks after finishing a pass
    "minStart": 15.0,               // pulling out needs the vehicle itself this far clear of the junction it just left
    "endAbortMargin": 30.0,         // an overtaker this close to the end of the lane gives up
    "endRoom": 20.0,                // extra room left past the pass before the end of the lane
    "standingObstacle": 15.0,       // oncoming vehicle this close: no room to carry on whatever its speed
    "maxLeaderGap": 30.0,           // only consider a leader this close ...
    "minLeaderSpeed": 1.0,          // ... that is moving at least this fast ...
    "slowLeaderShare": 0.85,        // ... and slower than this share of our free speed ...
    "minSpeedDeficit": 1.5,         // ... by at least this much
    "queueSpeed": 2.0,              // a vehicle crawling below this is part of a queue
    "queueLookahead": 100.0,        // never start a pass with a queue this close ahead of the target
    "haltedLookahead": 80.0,        // nor with a halted vehicle this close ahead of the target
    "stuckBase": 1.5,               // seconds held up before trying: base + patience * stuckPatience
    "stuckPatience": 6.0,
    "boost": 1.1,                   // free speed while passing: boost + aggression * boostAggression
    "boostAggression": 0.1,
    "passLengthPad": 16.0,          // distance to cover for a pass: gap + 2 vehicle lengths + this
    "minRelativeSpeed": 2.0,        // floor on closing speed when timing a pass
    "sightBase": 60.0,              // how far ahead oncoming traffic is seen: base + attention * sightAttention
    "sightAttention": 240.0,
    "misperception": 0.6,           // inattentive drivers underestimate oncoming speed by up to this share
    "believedTimeBase": 0.6,        // ... and the duration of the pass: time * (base + attention * believedTimeAttention)
    "believedTimeAttention": 0.4,
    "safetyMargin": 30.0,           // extra distance wanted before oncoming traffic, shrunk by aggression
    "safetyAggression": 0.5,
    "abortTimeBase": 1.5,           // abort when oncoming time-to-collision falls below base + attention * abortTimeAttention
    "abortTimeAttention": 2.0,
    "returnBehindBase": 5.0,        // room needed behind to pull back in: base + perSpeedDifference * (their speed - ours)
    "returnBehindPerSpeed": 2.0,
    "returnAheadBase": 6.0,         // room needed ahead to pull back in: base + perSpeedDifference * (our speed - theirs)
    "returnAheadPerSpeed": 1.5
  },

  // Rescue crews. The crews a depot keeps depend on its level.
  "crews": {
    "dispatchDelay": 10.0,
    "speed": 16.0,                  // by road
    "roadDetour": 1.4,              // road distance over straight-line distance
    "fallbackResponse": 300.0,      // no depot can respond sooner: help comes from far away
    "clearDuration": 45.0,
    "depotSnapRadius": 60.0,        // a depot goes on the node nearest the point clicked within this distance
    "depotHalfSize": 11.0,          // half the side of a free-standing depot's square: its access point is this far (plus the access margin) from its middle
    "depotBesideRadius": 24.0,      // a free-standing depot clicked within this distance of a road stands against it, with its access point on the road
    "incidentsKept": 500,           // cleared incidents kept in memory for the record (the oldest are dropped once there are more); open ones are never dropped
    "perDepot": { "simple": 1, "workshop": 1, "complex": 2 }
  },

  "roads": {
    "twoLane": { "speedLimit": 14.0, "costPerMetre": 40.0 },
    "avenue": { "speedLimit": 19.0, "costPerMetre": 90.0 },
    "path": { "speedLimit": 8.0, "costPerMetre": 15.0 }, // the stone road that joins an access point to the roads (M6e); never chosen by the player
    "cutCostPerCubicMetre": 6.0,
    "fillCostPerCubicMetre": 9.0,
    "earthworkSlope": 1.5,          // horizontal metres per metre of height at the edge of a cut or fill
    "demolitionCostPerMetre": 10.0,
    "upgradeRefundShare": 0.5,      // of the two-lane price, for the part reused when widening to an avenue
    "downgradeCostPerMetre": 15.0,  // narrowing an avenue to a two-lane road
    "speedLimitChangeCostPerMetre": 1.0, // re-signing a road
    // Bridges and tunnels: a road that would need a fill deeper than maxFillDepth, a cut deeper than maxCutDepth, or
    // that crosses water, is built as a structure instead (no earthworks).
    "maxFillDepth": 6.0,            // metres of embankment before a bridge takes over
    "maxCutDepth": 8.0,             // metres of cutting before a tunnel takes over
    "structureMargin": 8.0,         // a structure starts this far before the ground that calls for it, and ends this far after
    "crossingClearance": 5.5,       // a road passes over or under another (no junction) when their surfaces are this far apart, with a bridge above or a tunnel below
    "bridgeCostPerMetre": 320.0,    // two-lane; replaces the road and earthwork price
    "tunnelCostPerMetre": 520.0,
    "avenueStructureFactor": 1.6,   // an avenue on a bridge or in a tunnel costs this much more
    // Traffic lights (M4): the approaches of a junction fall in two groups by the direction they come from; the groups take turns.
    "trafficLight": { "price": 12000, "upkeepPerDay": 240.0, "greenSeconds": 18.0, "clearSeconds": 4.0 },
    // Signs (M4): a priority road sign on an approach, and the opposite one, makes every approach without a sign give way to it; a yield sign
    // makes its own approach give way to every approach without one; a stop sign is a yield sign after a full stop of stopSeconds. Approaches
    // of the same kind take the junction by arrival, as at a junction without signs. approachRange is how far back a vehicle that gives way looks.
    "signs": { "priorityPrice": 700, "yieldPrice": 500, "stopPrice": 500, "pickRadius": 30.0, "approachRange": 90.0, "stopSeconds": 1.5, "stopSpeed": 0.4, "stopLine": 5.0 }
  },

  // The company's money. One day is dayLength seconds of simulated time: upkeep and interest are charged daily. A day (1200 s) is
  // the cycle of people's lives, long enough for a commute to be a small part of it; a month is only daysPerMonth days, the calendar of
  // the campaign (96 months from January 1938 are 288 days). The per-day amounts are twice what they were for a 600 s day and the
  // per-month amounts (production, needs, construction) a fifth of what they were for a 30-day month, so every flow is unchanged per second.
  "economy": {
    "startingMoney": 1000000,
    "maxLoan": 1000000,
    "dayLength": 1200.0,
    "daysPerMonth": 3,              // the calendar: shown on the HUD, and the pace of town growth
    "startYear": 1938,              // the first month of a game is January of this year
    "monthsPerYear": 12,
    "interestPerDay": 0.008,        // share of the loan, charged every day
    "sellRefundShare": 0.6,         // of the price, paid when a vehicle is sold
    "parkedUpkeepShare": 0.1,       // of its daily upkeep, paid by a vehicle or train waiting in a depot on no line
    "depotPrice": { "simple": 15000, "workshop": 40000, "complex": 90000 }
  },

  // The campaign (C4): a region at war from January 1938, 96 months. The government gives the committee an allocation at the turn
  // of every month (the phase's amount times a factor of the standing) and judges it by its standing, 0 to 100. Each month the
  // standing moves by what was delivered to the gateways against what the phase expects (exports are valued at the cargo's pay per
  // unit and km), less a penalty for a deficit (money below zero) and for fines; the orders of C5 will add their own bonuses and
  // penalties. Under 'dismissBelow' for 'dismissMonths' months in a row the committee is dismissed and the game is over; at the end of
  // the 96 months a grade is given from the standing, the value of what was delivered and the towns' satisfaction.
  "campaign": {
    "country": "Veldmar",
    "region": "Marren Valley",
    "months": 96,
    "startStanding": 60.0,
    "dismissBelow": 20.0,
    "dismissMonths": 6,
    "allocationBase": 0.5,          // allocation factor = base + perStanding * standing: 1.0 at a standing of 50, 1.5 at 100, 0.5 at 0
    "allocationPerStanding": 0.01,
    "exportScale": 8000.0,          // value delivered above (or below) what the phase expects that moves the standing by one point ...
    "maxExportSwing": 3.0,          // ... up to this many points a month either way
    "deficitPenalty": 2.0,          // standing lost at the turn of a month that finds the money below zero
    "finePenaltyUnit": 2000.0,      // money in fines that costs one point of standing ...
    "maxFinePenalty": 5.0,          // ... up to this many a month
    // The phases of the war, from the month index at which each starts (January 1938 is 0). allocation: money a month at a standing of 50; expectedValue: value
    // delivered to the gateways a month that leaves the standing as it is. Set in M6c by the campaign bots (CampaignBalanceTests): an idle committee loses
    // 2 points a month in rearmament and is dismissed at month 25; a competent player who keeps a few lines to the road gateway stays high.
    "phases": [
      { "id": "rearmament", "name": "Rearmament", "fromMonth": 0, "allocation": 45000, "expectedValue": 16000.0 },
      { "id": "mobilisation", "name": "Mobilisation", "fromMonth": 20, "allocation": 60000, "expectedValue": 22000.0 },
      { "id": "totalwar", "name": "Total war", "fromMonth": 48, "allocation": 80000, "expectedValue": 26000.0 },
      { "id": "end", "name": "The end", "fromMonth": 84, "allocation": 50000, "expectedValue": 20000.0 }
    ],
    "grade": {
      "standingWeight": 0.5,
      "productionWeight": 0.3,
      "satisfactionWeight": 0.2,
      "productionTarget": 600000.0, // total value delivered that counts as full marks for production
      "thresholds": [85.0, 55.0, 35.0],   // the score needed for the first, second and third grade; below the last is the fourth
      "names": ["Distinguished service", "Creditable service", "Adequate service", "Unsatisfactory service"]
    }
  },

  // The war (C9). Rationing: in the phases of the war the goods the Region needs from outside get dearer and scarcer. For the cargo listed, the
  // price of an import is the offer's price times priceFactor and a shipment is the offer's units times unitsFactor (at least 1 unit) in the
  // phase it is asked for. How much of that applies is set by the frequency option (off: none; low: half the change; normal: all of it; high:
  // twice the change).
  "war": {
    "rationing": {
      "cargo": ["oil", "fuel", "rubber", "ammunition"],
      "phases": [
        { "phase": "rearmament", "priceFactor": 1.0, "unitsFactor": 1.0 },
        { "phase": "mobilisation", "priceFactor": 1.25, "unitsFactor": 0.85 },
        { "phase": "totalwar", "priceFactor": 1.7, "unitsFactor": 0.65 },
        { "phase": "end", "priceFactor": 2.0, "unitsFactor": 0.5 }
      ]
    },
    // The call-up (C9b): at the start of each month listed, 'share' of the people of every trip group are called up (they leave for good; they are
    // only a number in the Region's books). The workforce falls: the share missing 'gap' goes to 1 - (1 - gap) * (1 - share) and every industry makes
    // its output times 1 - outputLoss * gap (the people called up are also missing from the trip groups that staff the big industries), and
    // each town loses satisfactionLoss. The gap closes by recoveryPerMonth a month (those who stayed work more).
    "conscription": {
      "outputLoss": 0.7,
      "recoveryPerMonth": 0.012,
      "satisfactionLoss": 3.0,
      "waves": [
        { "month": 22, "share": 0.06 },
        { "month": 34, "share": 0.08 },
        { "month": 50, "share": 0.10 },
        { "month": 62, "share": 0.10 },
        { "month": 74, "share": 0.08 }
      ]
    },
    // Requisitions (C9c): at the start of each month listed the army buys 'share' of the company's vehicles and trains (the freight ones first, then
    // the biggest) at priceShare of the price new, whatever their Condition; the player cannot refuse, and is told noticeMonths ahead so as to
    // prepare. The army's good opinion adds 'standing' points when something was taken. Vehicles in a depot's garage count too.
    "requisition": {
      "noticeMonths": 1,
      "priceShare": 0.8,
      "standing": 1.0,
      "waves": [
        { "month": 26, "share": 0.15 },
        { "month": 40, "share": 0.20 },
        { "month": 56, "share": 0.25 },
        { "month": 72, "share": 0.25 }
      ]
    },
    // Raids (C12): from month 'fromMonth' (January 1942) a flight of enemy aircraft comes every minDays to maxDays of the phase (scaled by the
    // frequency option: off none, low half as often, high twice as often). The flight has between min and max aircraft of its phase and picks
    // a target by value: the weight of an industry is the value of its type, of a gateway, a town, a station, a depot or a signal the value of
    // its kind, times damagedFactor when it is down already and idleFactor for an industry that lacks an input. The aircraft come in from the
    // side of the map the game drew (spread by entryArc radians), fly straight at 'speed' m/s at 'altitude' m over the target and out of the
    // map, in a formation (trailSpacing behind each other, wingSpacing across). Each drops a stick of bombsPerAircraft bombs bombSpacing metres
    // apart, centred on the target; the whole stick may be aimError metres off across the path and each bomb scatter across and scatterAlong
    // along it. A bomb falls from 'altitude' and then blasts everything within blastRadius metres: a building is destroyed with a chance of
    // buildingChance at the centre falling to none at the edge (casualtyShare of its people counted as casualties, the town loses
    // townLossPerBuilding satisfaction), an industry stays down industryDownDays more per bomb (at most industryMaxDownDays from now) and loses
    // inputLoss of the stock it holds each time, a gateway, a station or a depot is shut for its number of days, every vehicle becomes a wreck
    // (carPeople for an ambient car, the passengers aboard for a company vehicle, all casualties), the nearest road within craterRadius gets
    // a crater with craterChance, and the nearest signal within the radius fails.
    "bombing": {
      "fromMonth": 48,
      "gaps": [
        { "phase": "totalwar", "minDays": 6, "maxDays": 12 },
        { "phase": "end", "minDays": 8, "maxDays": 14 }
      ],
      "aircraft": [
        { "phase": "totalwar", "min": 1, "max": 4 },
        { "phase": "end", "min": 2, "max": 6 }
      ],
      "speed": 75.0,
      "altitude": 320.0,
      "entryMargin": 300.0,
      "entryArc": 0.6,
      "revealSeconds": 10.0,
      "trailSpacing": 45.0,
      "wingSpacing": 40.0,
      "bombsPerAircraft": 5,
      "bombSpacing": 30.0,
      "aimError": 45.0,
      "scatter": 12.0,
      "scatterAlong": 8.0,
      "blastRadius": 35.0,
      "buildingChance": 0.9,
      "casualtyShare": 0.35,
      "townLossPerBuilding": 0.6,
      "carPeople": 2,
      "industryDownDays": 1,
      "industryMaxDownDays": 8,
      "inputLoss": 0.2,
      "gatewayDownDays": 2,
      "stationDownDays": 2,
      "depotDownDays": 2,
      "craterChance": 0.5,
      "craterRadius": 30.0,
      "industryValues": [
        { "type": "steelmill", "value": 14 },
        { "type": "powerplant", "value": 14 },
        { "type": "truckplant", "value": 14 },
        { "type": "engineworks", "value": 12 },
        { "type": "refinery", "value": 9 },
        { "type": "bodyworks", "value": 6 },
        { "type": "tyreworks", "value": 5 },
        { "type": "factory", "value": 5 },
        { "type": "coalmine", "value": 4 },
        { "type": "ironmine", "value": 4 },
        { "type": "cementworks", "value": 3 },
        { "type": "sawmill", "value": 3 },
        { "type": "foodplant", "value": 3 },
        { "type": "antiaircraft", "value": 8 }
      ],
      "defaultIndustryValue": 2,
      "gatewayValue": 6,
      "townValue": 3,
      "stationValue": 2,
      "depotValue": 2,
      "signalValue": 3,
      "damagedFactor": 0.15,
      "idleFactor": 0.4
    },
    // Anti-aircraft (C13): from month 'fromMonth' (September 1939) the player can place a battery (the industry type 'type') for 'price' and
    // 'upkeepPerMonth', on level dry ground at least 'clearance' metres from every other industry, gateway and battery and 'buildingClearance'
    // from any building, with no road or track under it. A news item announces it then, and another at 'expectMonth' that raids are expected.
    // A battery fires at every aircraft within 'range' metres, once a second a salvo that costs 'ammoPerSalvo' of its ammunition (none: no
    // fire); each salvo has a chance 'hitChance' times the battery's staffing to bring the aircraft down, several batteries together
    // 1 - the product of what each misses. A downed aircraft falls for as long as a bomb takes, carrying on 'fallCarry' of the way it would
    // have flown meanwhile, and leaves a crater with 'fallCraterChance'. Fire pressure on a flight is the staffing of the batteries that fire at it:
    // its bombs then scatter (1 + scatterGrowth * pressure) times as much, at most scatterCap times, and are let go 'earlyRelease' metres early
    // at a pressure of 1 or more, so they fall short. The enemy's wish for a target is multiplied by 1 - (1 - strongCover) * cover, where cover is
    // the staffing of the working batteries that reach it, over coverSaturation, at most 1.
    "antiAircraft": {
      "type": "antiaircraft",
      "fromMonth": 20,
      "expectMonth": 40,
      "price": 45000,
      "upkeepPerMonth": 3000,
      "clearance": 120.0,
      "buildingClearance": 30.0,
      "maxHeightRange": 3.0,
      "range": 700.0,
      "hitChance": 0.12,
      "ammoPerSalvo": 1.0,
      "fallCarry": 0.3,
      "fallCraterChance": 1.0,
      "scatterGrowth": 1.5,
      "scatterCap": 3.0,
      "earlyRelease": 150.0,
      "coverSaturation": 2.0,
      "strongCover": 0.5
    },
    // Civilians (C14): when a flight is launched the siren sounds; people on foot, and people waiting in a station queue, run to the nearest standing
    // building they can reach before the first bomb could land (the flight's lead time less reactionSeconds, at the walking speed of 'trips'), stay
    // there until the all-clear (the flight is over) and then go on. A group that is to leave on foot or for a station while the siren is on stays
    // in and looks again every recheckSeconds. People in cars and buses keep driving; people already in a building stay in it.
    "civilians": {
      "reactionSeconds": 5.0,
      "recheckSeconds": 3.0
    }
  },

  // Electricity (C6): a regional capacity, not a cargo and not a network. Every industry type has a demand in megawatts (always, working or
  // not) and a power plant a supply; a plant gives its megawatts while it has coal to burn (perMonth of its type). The grid the map started with
  // supplies the demand of the industries that stood at the start times freeGridMargin, so the first game runs at full power; what the state
  // works add must be met by a plant or by power bought from outside by the month (pricePerMegawattMonth, at most maxPurchase, in steps of
  // purchaseStep, charged at the turn of every month). When the demand is above the supply every industry makes its output times supply / demand.
  "power": {
    "freeGridMargin": 1.1,
    "pricePerMegawattMonth": 1500,
    "maxPurchase": 40,
    "purchaseStep": 5
  },

  // The government's orders (C5). Offers come at random intervals (the gap depends on the phase of the war), at most maxOpen at once; the
  // player accepts up to maxActive, and an offer nobody accepts lapses after offerExpiryDays. Kinds: 'quota' (deliver units of a cargo to
  // one gateway, whatever its source), 'civil' (deliver units of a cargo to a town's buildings) and 'statework' (the state founds the
  // listed industries on the map when the order is accepted and wants units of the cargo delivered to a gateway). Meeting an order pays its
  // reward into the budget and raises the standing; at the deadline an order with at least lateShare delivered pays in proportion with no
  // penalty, under that it has failed: a fine of failedFineShare of the reward, and the standing falls by standingLossFactor times what it
  // would have gained. A template is drawn only in the phases named in weights. The reward is rewardPerUnit times the units drawn.
  "orders": {
    "maxActive": 3,
    "maxOpen": 5,
    "offerExpiryDays": 6,            // two months
    "failedFineShare": 0.25,
    "lateShare": 0.5,
    "townGain": 3.0,                 // satisfaction of the town of a civil need that is met ...
    "townLoss": 3.0,                 // ... and of one that is failed
    "standingLossFactor": 1.5,
    "repeatRedraws": 4,
    // The first order, offered when the game begins: easy, to be met by building one station at a producer and one at the gateway.
    "tutorial": { "cargo": ["wood", "grain", "stone"], "units": 60, "days": 15, "expiryDays": 15, "reward": 6000, "standing": 4.0 },
    "gaps": [
      { "phase": "rearmament", "minDays": 4, "maxDays": 8 },
      { "phase": "mobilisation", "minDays": 3, "maxDays": 6 },
      { "phase": "totalwar", "minDays": 2, "maxDays": 5 },
      { "phase": "end", "minDays": 3, "maxDays": 6 }
    ],
    "sites": { "attempts": 600, "townReach": 2600.0, "clusterReach": 1300.0, "minSpacing": 350.0, "townClearance": 150.0, "maxHeightRange": 5.0 },
    "templates": [
      { "id": "timber", "kind": "quota", "cargo": "wood", "weights": { "rearmament": 4, "mobilisation": 2 }, "minUnits": 80, "maxUnits": 200, "minDays": 9, "maxDays": 15, "rewardPerUnit": 60, "minStanding": 2.0, "maxStanding": 4.0, "works": [], "once": false },
      { "id": "stone", "kind": "quota", "cargo": "stone", "weights": { "rearmament": 3 }, "minUnits": 80, "maxUnits": 200, "minDays": 9, "maxDays": 15, "rewardPerUnit": 50, "minStanding": 2.0, "maxStanding": 3.0, "works": [], "once": false },
      { "id": "planks", "kind": "quota", "cargo": "planks", "weights": { "rearmament": 3, "mobilisation": 3, "totalwar": 2 }, "minUnits": 60, "maxUnits": 160, "minDays": 9, "maxDays": 15, "rewardPerUnit": 90, "minStanding": 2.0, "maxStanding": 4.0, "works": [], "once": false },
