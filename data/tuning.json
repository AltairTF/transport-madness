  // Towns: generated with the map, made of buildings on lots beside their streets (M3a). Satisfaction is 0 to 100 per town.
  "towns": {
    "names": [
      "Aldermark", "Brennau", "Corvenholt", "Dravik", "Eskerfeld", "Falkenmoor", "Grauwald", "Harlenburg", "Isenhaven", "Jelenfeld",
      "Karnbruck", "Lorvenau", "Marrenstadt", "Norvik", "Ostenhal", "Pellenau", "Quernheim", "Rothmoor", "Sarnfeld", "Tavenburg",
      "Ulvenhof", "Varnholt", "Wessenau", "Zorvenburg"
    ],
    "initialSatisfaction": 60.0,
    "maxSatisfaction": 100.0,
    "recoveryPerMonth": 1.0,        // satisfaction regained every month, up to the maximum
    "demolishedPenalty": 0.5,       // lost for every building demolished to make room for a road
    "abandonedPenalty": 2.0,        // lost for every building that is marked abandoned
    "accessRadius": 40.0,           // a building has road access when a road's centre line is this close to its middle
    "inactiveMonths": 3,            // months without road access before a building is marked abandoned ...
    "abandonedMonths": 1,           // ... and months after that before the town demolishes it
    "unmetPenalty": 3.0,            // satisfaction lost each month if none of the buildings' needs were met; less in proportion to what was
    "initialStockMonths": 1.5,      // months of its monthly needs a building starts with in stock
    "sustainStockMonths": 2.0,      // months of its monthly needs a building keeps in stock at most

    // Growth (M3d), evaluated for every town at the turn of each month. A building whose construction stock is full for its
    // size goes up one size; one already at the top size spends a full stock on a new building on a free lot of its town (the
    // nearest to it), or on a new block of streets when no lot is free. Nothing grows while the town's satisfaction or its
    // connectivity is below its threshold. Connectivity is the share of the town's homes from which a group made a trip to
    // work or leisure that month within the time budget.
    "growth": {
      "minSatisfaction": 50.0,
      "minConnectivity": 0.6,
      "timeBudgetSeconds": 300.0,
      "lotClearance": 13.0,         // a free lot is built on only when no road runs closer than this to its middle
      "extendGrid": true            // a town with no free lot builds a new block of streets
    },

    // Where and how a town is laid out: a square grid of streets (the middle one an avenue) with two lots per block side.
    "generation": {
      "attempts": 600,              // random places tried for each town
      "edgeMargin": 300.0,          // a town stays this far from the edge of the map
      "minSpacing": 700.0,          // between town centres
      "maxHeightRange": 12.0,       // highest minus lowest ground under the town
      "waterMargin": 1.5,           // ground must stand this far above the water surface everywhere under the town
      "blocksMin": 3,               // blocks along each side of the grid
      "blocksMax": 4,
      "blockLength": 120.0,         // street to street; buildings stand on all four sides of a block, two to a side
      "lotWidth": 30.0,             // between the middles of the two buildings on one side of a block
      "setbackGap": 1.5,            // clear space between the pavement of a street and a building
      // R3: sites are scored, then towns are picked best first; the best gets the metropolis size, a share the medium size, the rest blocksMin..blocksMax.
      "sizes": {
        "candidates": 500,          // random sites scored for the whole map
        "siteRadius": 400.0,        // half the side of the square of ground scored around a site
        "waterShare": 0.3,          // the most of a town's disc that may be water (rivers and bays are bridged)
        "waterBonus": 0.35,         // score added to a site with water close by
        "waterBonusReach": 500.0,   // ... within this of the middle
        "metropolisBlocks": 11,
        "metropolisMinTowns": 4,    // a map with fewer towns has no metropolis
        "mediumShare": 0.3,
        "mediumBlocksMin": 6,
        "mediumBlocksMax": 7,
        "spacingShare": 1.2,        // two towns are at least this share of the sum of their radii apart (streets reach outerReach times the radius) ...
        "spacingGap": 0.0           // ... plus this
      },
      // Town upgrade (docs/town-upgrade-plan.md): two or three seed roads cross at the square; collector streets leave them at right angles at every
      // block step, local streets close the blocks between neighbouring collectors, and the town grows from the middle out until its people add up.
      "streets": {
        "seedRoadsVillage": 2,
        "seedRoadsMedium": 3,
        "seedRoadsMetropolis": 3,
        "populationVillage": 400,   // people a town starts with (in its homes), by size class: the streets and buildings are laid until they add up
        "populationMedium": 2500,
        "populationMetropolis": 8000,
        "blockMin": 60.0,           // one step along a seed road: the distance between two collectors
        "blockMax": 66.0,
        "depthMin": 60.0,           // one step along a collector: the distance between two local streets
        "depthMax": 68.0,
        "maxDepth": 14,             // steps a collector may take from its seed road
        "maxSlope": 0.18,           // rise over run a street piece may climb
        "streetClearance": 44.0,    // two streets that are not joined keep this far apart
        "maxDeadEnd": 84.0,         // a street end that joins nothing is at most this far from the junction it hangs off
        "bridgeMax": 70.0,          // the longest water a seed road may cross (as a bridge)
        "outerReach": 1.1,          // streets stay within this share of the town's nominal radius from its centre
        "seedReach": 90.0,          // seed roads run this far beyond that
        "mainReach": 0.6,           // the first seed road is an avenue within this share of the nominal radius
        "slotClearance": 40.0,      // a collector leaves a seed road at least this far from a junction of it
        "pavement": 2.5             // width of the pavement each side of an urban street
      }
    },

    // From the middle of a town out. 'until' is the distance from the centre as a share of half the grid; 'fill' the
    // share of lots that start built on; 'mix' the weights of home, commerce and industry; 'tiers' the weights of the sizes.
    "rings": [
      { "until": 0.35, "fill": 0.95, "mix": [0.35, 0.60, 0.05], "tiers": [0.2, 0.4, 0.4], "frontage": 20.0, "maxTier": 1 },
      { "until": 0.70, "fill": 0.85, "mix": [0.65, 0.25, 0.10], "tiers": [0.4, 0.6, 0.0], "frontage": 22.0, "maxTier": 1 },
      { "until": 99.0, "fill": 0.70, "mix": [0.70, 0.10, 0.20], "tiers": [1.0, 0.0, 0.0], "frontage": 28.0, "maxTier": 0 }
    ],

    // One list per kind of building, three sizes each. size: half the side of the square it stands on, in metres.
    // people live in a home (and travel as trip groups, see 'trips'); jobs are in commerce and industry. sustain: what the
    // building uses up each month (a shortfall lowers the town's satisfaction); construction: how much it can hold of what
    // building (M3d) will spend.
    "buildingTypes": [
      { "id": "home", "tiers": [
        { "size": 8.0, "height": 6.0, "people": 8, "jobs": 0, "demolitionPrice": 3000,
          "sustain": [{ "cargo": "food", "amount": 4 }, { "cargo": "goods", "amount": 2 }],
          "construction": [{ "cargo": "materials", "amount": 8 }, { "cargo": "planks", "amount": 4 }] },
        { "size": 10.0, "height": 12.0, "people": 20, "jobs": 0, "demolitionPrice": 7000,
          "sustain": [{ "cargo": "food", "amount": 10 }, { "cargo": "goods", "amount": 5 }],
          "construction": [{ "cargo": "materials", "amount": 20 }, { "cargo": "planks", "amount": 10 }] },
        { "size": 12.0, "height": 24.0, "people": 50, "jobs": 0, "demolitionPrice": 16000,
          "sustain": [{ "cargo": "food", "amount": 24 }, { "cargo": "goods", "amount": 12 }],
          "construction": [{ "cargo": "materials", "amount": 48 }, { "cargo": "planks", "amount": 24 }] }
      ] },
      { "id": "commerce", "tiers": [
        { "size": 8.0, "height": 6.0, "people": 0, "jobs": 6, "demolitionPrice": 4000,
          "sustain": [{ "cargo": "goods", "amount": 6 }],
          "construction": [{ "cargo": "materials", "amount": 8 }, { "cargo": "planks", "amount": 4 }] },
        { "size": 10.0, "height": 10.0, "people": 0, "jobs": 16, "demolitionPrice": 9000,
          "sustain": [{ "cargo": "goods", "amount": 16 }],
          "construction": [{ "cargo": "materials", "amount": 20 }, { "cargo": "planks", "amount": 10 }] },
        { "size": 12.0, "height": 18.0, "people": 0, "jobs": 40, "demolitionPrice": 20000,
          "sustain": [{ "cargo": "goods", "amount": 36 }],
          "construction": [{ "cargo": "materials", "amount": 48 }, { "cargo": "planks", "amount": 24 }] }
      ] },
      { "id": "industry", "tiers": [
        { "size": 9.0, "height": 6.0, "people": 0, "jobs": 10, "demolitionPrice": 5000,
          "sustain": [{ "cargo": "planks", "amount": 6 }],
